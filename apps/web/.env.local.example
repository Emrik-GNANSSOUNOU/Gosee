# Copier ce fichier en `.env.local` dans apps/web/ (jamais commit).
# Ces valeurs viennent de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publique du site (sans slash final), utilisée pour les canonicals,
# Open Graph, robots.txt et sitemap.xml. En prod : le domaine Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
